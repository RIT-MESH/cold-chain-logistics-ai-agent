# Copy to .env; never commit actual keys/passwords
# Runtime LLM: NVIDIA NIM — the ONLY supported provider (operator decision
# 2026-11-08, blueprint R6-1; endpoint live-verified 2026-11-03, 10/10 PASS —
# architecture-review/NVIDIA_NIM_API_VERIFICATION.md). No local model, no GPU,
# no silent fallback to any other provider.
LLM_PROVIDER=NVIDIA_NIM
NVIDIA_API_KEY=
# Production model adopted 2026-11-14 (blueprint P-8 / ledger R6-2) on the
# post-repair qualification: glm-5.3-flash 14/15 complete_correct, zero API
# failures — docs/evidence/NVIDIA_NIM_POST_REPAIR_QUALIFICATION.md
NVIDIA_MODEL=z-ai/glm-5.3-flash
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# One NIM model turn is live-verified at 46.7-79.3 s; a tool-using ReAct
# answer needs 2-4 sequential turns, so expect minutes per answer.
NVIDIA_REQUEST_TIMEOUT_SECONDS=180
NVIDIA_MAX_RETRIES=2
# Reasoning tokens consume the output budget: too-small caps return empty
# content with finish_reason=length (verification finding F-3).
NVIDIA_MAX_OUTPUT_TOKENS=4096
# OPENAI_API_KEY below is for OPTIONAL SOP-retrieval embeddings only — the
# chat pipeline has no OpenAI provider anymore.
Embeddings_model=LOCAL
# LOCAL BGE-M3 downloads model weights to CPU. OPENAI embeddings require separate paid API.
PINECONE_INDEX_NAME=
PINECONE_API_KEY=
# ---- Phase 6 SOP retrieval (blueprint 06; src/sop_embeddings.py) ----
# SOP_EMBEDDING_PROVIDER=NIM is the RECOMMENDED deployment: hosted
# BAAI/bge-m3 via the SAME NVIDIA NIM endpoint+key as the chat model
# (1024-dim; zero new credentials, zero app-host RAM). LOCAL is for
# dev-machine ingestion only (~2.5-3 GB; never on the app host).
# OPENAI would require a separate OpenAI key and bill.
SOP_EMBEDDING_PROVIDER=NIM
PINECONE_NAMESPACE=sops
SOP_TOP_K=3
SOP_MIN_SCORE=0.35
SOP_CHUNK_DISPLAY_LIMIT=700
# Ingestion knobs (blueprint C11) — used by scripts/ingest_sop_pinecone.py
SOP_CHUNK_SIZE=600
SOP_CHUNK_OVERLAP=60
SOP_UPSERT_BATCH=100
SOP_ACCESS_CLASSIFICATIONS=internal-operations,internal-demo
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_ADMIN_USER=sa
SQL_ADMIN_PASSWORD=
SQL_AGENT_USER=USR_FDE_RO
SQL_AGENT_PASSWORD=
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=no
FDE_API_KEY=
LIBRECHAT_PUBLIC_URL=http://localhost:3080
GRAFANA_PUBLIC_DASHBOARD_URL=http://localhost:3000/d/cold-chain-unified/unified-cold-chain

# Optional Floci local AWS telemetry emulator. Never use dummy credentials on real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1

# For Floci-only local shell, export dummy AWS keys temporarily; NEVER use them on AWS.
TELEMETRY_BUCKET=coldchain-local-telemetry
TELEMETRY_QUEUE_NAME=coldchain-telemetry
TELEMETRY_ALERT_TOPIC_NAME=coldchain-alerts
TELEMETRY_THRESHOLD_C=4.0
TELEMETRY_INCIDENT_OUTPUT=./data/cache/floci_incidents.jsonl

# Optional SQL incident projection (requires scripts/setup_telemetry.sql and a separate writer user)
SQL_DATABASE=ColdChainLogistics
SQL_INCIDENT_WRITER_USER=USR_INCIDENT_WRITER
SQL_INCIDENT_WRITER_PASSWORD=
TELEMETRY_PERSIST_SQL=false
GRAFANA_PUBLIC_INCIDENT_URL=http://localhost:3000/d/cold-chain-incidents/telemetry-incidents

# SQLite for Streamlit demo, mssql to connect dashboard to the same SQL Server as Grafana/AI
UNIFIED_DATA_BACKEND=sqlite

# Floci synthetic events can reference an existing unified shipment ID
DEMO_SHIPMENT_ID=UC-003241

# UI SQL login requires SELECT on unified tables; agent and Grafana use approved views only.
# For AWS set UNIFIED_DATA_BACKEND=mssql. SQLite is for lightweight local preview only.

SQL_UI_USER=USR_COLDCHAIN_UI_RO
SQL_UI_PASSWORD=
