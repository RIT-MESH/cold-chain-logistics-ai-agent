# Compute module — the single EC2 app host (blueprint 01 §3/§9, ADR-1,
# ADR-13, ADR-16/R3-1: HOST PROVISIONED FIRST, before any import).
#
# Phase 2 scope: host + instance profile + EBS + SSM + Docker, ZERO
# application containers and NO ALB — the effective inbound surface is
# EMPTY (sg-app accepts only sg-alb, which does not exist until Phase 3;
# SSM admin is outbound-initiated). No SSH key pair is ever created.
#
# Capacity (ADR-17): t3.large is the TEST CANDIDATE — adequacy is declared
# only after the Phase 3 measured load test (R4-4).
#
# Secrets (C8/ADR-5): user data installs Docker ONLY — zero credentials.
# The instance profile may READ the empty secret containers; values are
# seeded out-of-band and fetched at runtime into tmpfs.

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

# AMI is PINNED to a specific AL2023 build (2026-11-15) — a `most_recent`
# data source is a replacement time-bomb: every time AWS publishes a newer
# AL2023 image, `terraform plan` replaces the app host (found live
# 2026-11-15: an unplanned instance replacement destroyed
# i-08144f6c6b0999dfe). Pinning trades zero-cost AMI updates for host
# stability; bump var.ami_id deliberately when an update is wanted.
data "aws_ami" "al2023" {
  owners = ["amazon"]
  filter {
    name   = "image-id"
    values = [var.ami_id]
  }
  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

locals {
  name_prefix = "coldchain-${var.environment}"
  common_tags = {
    Project     = "coldchain"
    Environment = var.environment
    ManagedBy   = "terraform"
    Phase       = "phase2"
  }
}

# ------------------------------------------------------------------ IAM

# SSM management without any inbound port (SSM agent is outbound-initiated).
resource "aws_iam_role" "app_host" {
  name = "${local.name_prefix}-app-host"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "ec2.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
}

# AWS-managed SSM core (Session Manager + RunCommand) — no SSH anywhere.
resource "aws_iam_role_policy_attachment" "ssm_core" {
  role       = aws_iam_role.app_host.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
}

# Runtime permissions, least-privilege per blueprint 01 §6 (instance
# profile row): read ONLY the project's named secret ARNs; CW logs; the
# Phase 4 event-plane permissions (SQS consume, S3 archive put, SNS
# publish) ship here now so the host never needs a policy change mid-life.
resource "aws_iam_role_policy" "app_host" {
  name = "runtime-least-privilege"
  role = aws_iam_role.app_host.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid      = "ReadOnlyExactSecretArns"
        Effect   = "Allow"
        Action   = "secretsmanager:GetSecretValue"
        Resource = var.secret_arns # exact ARNs from modules/secrets + the RDS-managed master secret
      },
      {
        Sid    = "SqlIdentitySeedingPhase2"
        Effect = "Allow"
        Action = "secretsmanager:PutSecretValue"
        # 01 §5.4: consumer SQL passwords are GENERATED BY THE SEEDING STEP
        # (which runs on this host) and stored in the sql-* containers. The
        # external-provider keys (nvidia/fde/pinecone) remain operator-seeded
        # out-of-band — the host can never write those.
        Resource = ["arn:aws:secretsmanager:*:*:secret:coldchain/${var.environment}/sql-*"]
      },
      {
        Sid      = "CloudWatchLogsApp"
        Effect   = "Allow"
        Action   = ["logs:CreateLogStream", "logs:PutLogEvents", "logs:DescribeLogStreams"]
        Resource = ["arn:aws:logs:*:*:log-group:/coldchain/${var.environment}/*"]
      },
      {
        # READ-ONLY CloudWatch metrics for the Grafana infra dashboard
        # (Phase 3 Dashboard D — real AWS metrics only; live-found
        # 2026-11-16: the app-host role could not cloudwatch:GetMetricData).
        # Narrowly scoped metric/alarm READ actions; no write, no logs read.
        Sid    = "CloudWatchMetricsReadOnly"
        Effect = "Allow"
        Action = [
          "cloudwatch:GetMetricData",
          "cloudwatch:GetMetricStatistics",
          "cloudwatch:ListMetrics",
          "cloudwatch:DescribeAlarms",
        ]
        Resource = "*"
      },
      {
        # PHASE 5 (operator approval 2026-11-17): read-only CloudWatch LOGS
        # access so the Grafana agent-audit dashboard can run Logs Insights
        # drill-down panels over the structured audit JSON lines. Resource
        # scope: the EXACT gateway log group (operator-approved scope) —
        # these four actions support log-group-level resources.
        Sid    = "CloudWatchLogsReadOnlyAuditPanels"
        Effect = "Allow"
        Action = [
          "logs:DescribeLogStreams",
          "logs:GetLogEvents",
          "logs:FilterLogEvents",
          "logs:StartQuery",
        ]
        Resource = ["arn:aws:logs:*:*:log-group:/coldchain/${var.environment}/gateway"]
      },
      {
        # PHASE 5 companion statement: these four actions cannot be scoped
        # to a known resource — GetQueryResults/StopQuery/DescribeQueries are
        # addressed by opaque query ids, and DescribeLogGroups only accepts
        # "*" — so they use the minimum documented scope: read-only actions,
        # no write, no delete. Listed separately so the exact-group statement
        # above stays clean for audit review.
        Sid    = "CloudWatchLogsReadOnlyQueryResults"
        Effect = "Allow"
        Action = [
          "logs:DescribeLogGroups",
          "logs:GetQueryResults",
          "logs:StopQuery",
          "logs:DescribeQueries",
        ]
        Resource = ["*"]
      },
      {
        Sid    = "EventPlanePhase4"
        Effect = "Allow"
        Action = [
          "sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes", "sqs:GetQueueUrl",
          "s3:GetObject", "s3:PutObject",
          "sns:Publish",
        ]
        Resource = [
          "arn:aws:sqs:*:*:coldchain-${var.environment}-*",
          "arn:aws:s3:::coldchain-${var.environment}-*/*",
          "arn:aws:sns:*:*:coldchain-${var.environment}-*",
        ]
      },
      {
        # Phase 4 (2026-11-17): controlled failure handling — the worker
        # writes rejected messages DIRECTLY to the telemetry DLQ with a
        # FailureReason attribute (invalid payload, bad shipment ref) so
        # poison messages do not churn maxReceiveCount cycles. Scoped to the
        # EXACT DLQ ARN from modules/events: SendMessage to the MAIN queue is
        # deliberately NOT granted (a compromised worker must not be able to
        # fabricate pipeline events).
        Sid      = "EventPlanePhase4DlqWrite"
        Effect   = "Allow"
        Action   = ["sqs:SendMessage"]
        Resource = [var.event_dlq_arn]
      },
      {
        # Phase 4 (2026-11-17): the reconcile step publishes its custom
        # metrics for the reconcile-pending / reconcile-exhausted alarms.
        # Namespace-conditioned: the host can only write ColdChain/Phase4.
        Sid       = "CloudWatchPutPhase4Metrics"
        Effect    = "Allow"
        Action    = ["cloudwatch:PutMetricData"]
        Resource  = "*"
        Condition = { StringEquals = { "cloudwatch:namespace" = "ColdChain/Phase4" } }
      },
    ]
  })
}

resource "aws_iam_instance_profile" "app_host" {
  name = "${local.name_prefix}-app-host"
  role = aws_iam_role.app_host.name
}

# ------------------------------------------------------------------ Instance

resource "aws_instance" "app_host" {
  ami                         = data.aws_ami.al2023.id
  instance_type               = var.instance_type # t3.large TEST CANDIDATE (ADR-17/R4-4)
  subnet_id                   = var.subnet_id     # public subnet — IGW egress, NO NAT (ADR-13)
  vpc_security_group_ids      = [var.sg_app_id]   # sg-app: inbound ONLY from sg-alb (none until Phase 3)
  iam_instance_profile        = aws_iam_instance_profile.app_host.name
  associate_public_ip_address = true # egress only; SGs default-deny inbound
  monitoring                  = true

  # NO key_name — no SSH key pair exists anywhere in this project (01 §3.1).
  metadata_options {
    http_endpoint = "enabled"
    http_tokens   = "required" # IMDSv2 only
  }

  root_block_device {
    volume_type = "gp3"
    volume_size = var.root_volume_size
    encrypted   = true
    tags        = merge(local.common_tags, { Name = "${local.name_prefix}-app-host-root" })
  }

  # Docker only — ZERO credentials in user data (C8/ADR-5); SSM agent is
  # preinstalled on AL2023. Application containers arrive with Phase 3.
  user_data = <<-EOT
    #!/bin/bash
    set -euxo pipefail
    dnf install -y docker
    systemctl enable --now docker
    usermod -a -G docker ec2-user
    dnf install -y python3-pip
    python3 -m pip install --upgrade pip
    mkdir -p /opt/coldchain
  EOT

  user_data_replace_on_change = true

  tags = merge(local.common_tags, { Name = "${local.name_prefix}-app-host" })
}
