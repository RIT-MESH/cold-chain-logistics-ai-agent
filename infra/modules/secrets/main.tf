# Secrets module — EMPTY secret CONTAINERS ONLY (correction C8 / ADR-5).
#
# Terraform creates secret metadata (name, description, tags, recovery
# window) and NOTHING else: there is deliberately NO
# aws_secretsmanager_secret_version anywhere in this module, so no secret
# VALUE ever enters Terraform state (asserted by tests/test_infra_phase1.py).
# Values are seeded OUT-OF-BAND by the operator:
#
#   aws secretsmanager put-secret-value --secret-id coldchain/dev/nvidia-api-key \
#       --secret-string '<value>'
#
# External-provider keys (NVIDIA_API_KEY, FDE_API_KEY, PINECONE_API_KEY)
# have no AWS-native rotation; they are opaque operator-seeded blobs.
# SQL passwords are generated by the Phase 2 seeding step and rotated via
# the DBA runbook (RDS-managed rotation covers only the master user).
# The documented exception (R4-1) is the Cognito app-client secret — that
# one is AWS-generated and lives in Cognito + Terraform state (Phase 3,
# 01 §7.1a); it is NOT one of these containers.

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

locals {
  common_tags = {
    Project     = "coldchain"
    Environment = var.environment
    ManagedBy   = "terraform"
    # Guards the infra-apply role's tag-scoped permissions (01 §6).
    Phase = "phase1"
  }
}

resource "aws_secretsmanager_secret" "this" {
  for_each = toset(var.secret_names)

  name                    = "coldchain/${var.environment}/${each.value}"
  description             = "EMPTY CONTAINER — value seeded out-of-band via CLI (C8/ADR-5); never in Terraform state"
  recovery_window_in_days = 7
  tags                    = merge(local.common_tags, { Name = "coldchain-${var.environment}-${each.value}" })
}
