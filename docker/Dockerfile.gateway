# Gateway + LangGraph agent image (Phase 3a). Build on the HOST:
#   docker compose -f docker/compose.yml build fde-api
# Base note: pyodbc needs the MS ODBC driver 18 inside the image.
FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends curl gnupg2 ca-certificates \
    && curl -sSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/microsoft.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" \
       > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update && ACCEPT_EULA=Y apt-get install -y msodbcsql18 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*     && curl -sSL https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem        -o /usr/local/share/ca-certificates/rds-global-bundle.crt     && update-ca-certificates

WORKDIR /app
# Both requirement files: the gateway imports agent_tools which imports the
# SOP-retrieval stack at module level (langchain_pinecone/huggingface).
COPY requirements.txt requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-api.txt

COPY src/ src/
COPY api/ api/

# Zero secrets in the image: everything arrives at runtime via the tmpfs
# env file /run/coldchain/app.env (compose env_file; C8/ADR-5).
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
