# Set in the FastAPI gateway environment (never commit real values)
FDE_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Existing project's required SQL, Pinecone and embedding variables
# must still be supplied through your original .env setup.

# The FastAPI process (not the browser) also needs the NVIDIA NIM runtime
# (the ONLY supported chat provider since the 2026-11-08 decision, R6-1):
LLM_PROVIDER=NVIDIA_NIM
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3-flash
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
